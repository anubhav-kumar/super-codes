# Copy to .env.local for local development. Values are baked into the public bundle: never put secrets here.

# Base URL of the deployed API (ApiBaseUrl output of the ca-crm-api-gateway-<stage> stack), no trailing slash.
# frontend/deploy.js sets this automatically at build time.
VITE_API_BASE_URL=

# Display name used in the UI and the web app manifest (defaults to "CA CRM").
VITE_APP_NAME=
