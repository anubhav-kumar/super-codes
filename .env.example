# Copy to apps/web/.env.local for the local web app and seed script.
# No secrets here: the session signing key (JWT_SECRET) and the WhatsApp settings are SSM
# parameters /vartalap/<stage>/... created by the stack (see docs/deployment.md), and AWS
# credentials come from your shell (e.g. `assume`), never from this file.

# Must match the stack's region and stage
AWS_REGION=ap-south-1
STAGE=dev

# From `serverless deploy` outputs
MESSAGES_TABLE=vartalap-dev-messages
CHATS_TABLE=vartalap-dev-chats
USERS_TABLE=vartalap-dev-users
OUTBOUND_QUEUE_URL=

# Optional: override the SSM parameter name for the session key (default /vartalap/<STAGE>/JWT_SECRET)
# JWT_SECRET_PARAM=

# Seed script (`npm run seed`). The first admin's password is generated and printed once.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin
