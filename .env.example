# Template for .env (copy to .env and fill in). Values are blank for secrets and machine-specific
# settings; generate JWT_SECRET/JWT_REFRESH_SECRET/CREDS_KEY with `openssl rand -hex 32`, CREDS_IV with
# `openssl rand -hex 16`. AWS_REGION and AWS_BUCKET_NAME are written by infra/deploy.py.

# Database (MongoDB Atlas connection string)
MONGO_URI=

# OpenRouter API key, referenced from librechat.yaml
OPENROUTER_KEY=

# Local URLs
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# App secrets: generated once, never change CREDS_KEY or CREDS_IV
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# Phase 1 settings
ALLOW_REGISTRATION=false
SEARCH=false
ENDPOINTS=agents,custom
AWS_REGION=
AWS_BUCKET_NAME=

# Phase 2: RAG API (rag-api reads this same file via find_dotenv)
RAG_API_URL=http://127.0.0.1:8000
RAG_HOST=127.0.0.1
RAG_PORT=8000
VECTOR_DB_TYPE=atlas-mongo
ATLAS_MONGO_DB_URI=${MONGO_URI}
COLLECTION_NAME=rag_embeddings
ATLAS_SEARCH_INDEX=vector_index
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=openai/text-embedding-3-small
RAG_OPENAI_BASEURL=https://openrouter.ai/api/v1
RAG_OPENAI_API_KEY=${OPENROUTER_KEY}
RAG_CHECK_EMBEDDING_CTX_LENGTH=false

# Phase 3: one LibreChat process without Redis, so the scheduler can arm
SCHEDULES_SINGLE_PROCESS=true
