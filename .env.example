# Copy to apps/web/.env.local. That's all the local web app needs. The scripts (seed, backfill,
# reset-data) don't read this file: they use the shell's region (`assume`) and STAGE (default dev).
# Everything else comes from SSM, published by the stack:
#   /vartalap/<STAGE>/config/*   table names and queue URL (loaded at startup)
#   /vartalap/<STAGE>/JWT_SECRET session signing key (set it once; see docs/deployment.md)
# AWS credentials come from your shell (e.g. `assume`), never from this file.

# Must match the stack's region and stage
AWS_REGION=ap-south-1
STAGE=dev

# I3 demo: WhatsApp onboarding via Embedded Signup (docs/demo-whatsapp-onboarding.md).
# Public IDs from the Meta app (not secrets). The app secret stays in SSM WA_APP_SECRET.
# Embedded Signup needs HTTPS: run `npm run dev:https` and open https://localhost:3000.
META_APP_ID=
META_ES_CONFIG_ID=
