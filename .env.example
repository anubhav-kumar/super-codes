# Copy to .env at the repo root (next to this file). It holds only the stage; the web app
# (apps/web/next.config.mjs) and the scripts (seed, backfill, reset-data, delete-client-media)
# all read it. A STAGE set in the shell wins.
# The region and AWS credentials come from your shell (`assume` sets AWS_REGION /
# AWS_DEFAULT_REGION), never from this file. Everything else comes from SSM, published by the stack:
#   /vartalap/<STAGE>/config/*          table names, queue URL, Graph API version (loaded at startup)
#   /vartalap/<STAGE>/JWT_SECRET        session signing key (set it once; see docs/deployment.md)
#   /vartalap/<STAGE>/META_APP_ID,      I3 demo: Meta app IDs for WhatsApp onboarding
#   /vartalap/<STAGE>/META_ES_CONFIG_ID (docs/demo-whatsapp-onboarding.md)
# apps/web/.env.local is no longer used; delete it if you still have one.

# Must match the stack's stage
STAGE=dev
