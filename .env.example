# Copy to apps/web/.env.local (web). Lambdas get their env from serverless.yml.
# Never commit real values.

# All
AWS_REGION=ap-south-1
STAGE=dev

# Web app + Lambdas (values come from `serverless deploy` outputs)
MESSAGES_TABLE=vartalap-dev-messages
CHATS_TABLE=vartalap-dev-chats
USERS_TABLE=vartalap-dev-users
OUTBOUND_QUEUE_URL=

# Web app
JWT_SECRET=

# Lambdas. In AWS these are SSM parameters /vartalap/<stage>/WA_* created by the stack;
# the functions receive the parameter names as WA_*_PARAM and read the values at runtime.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v26.0

# Seed script
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
